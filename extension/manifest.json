{
  "manifest_version": 3,
  "name": "Clean Links",
  "version": "1.0",
  "description": "Strips tracking parameters and share IDs from URLs, in the address bar and when copying or sharing links.",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "clean",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "clean.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "clean.js",
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}