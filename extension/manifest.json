{
  "manifest_version": 3,
  "name": "Clean Links",
  "version": "1.0.3",
  "description": "Strips tracking parameters and share IDs from links, in the address bar and when you copy or share.",
  "homepage_url": "https://arrhen.me/clean-links/",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png" },
  "action": {
    "default_title": "Clean Links",
    "default_popup": "popup.html",
    "default_icon": { "16": "icon-16.png", "32": "icon-32.png" }
  },
  "permissions": ["declarativeNetRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [{ "id": "clean", "enabled": true, "path": "rules.json" }]
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["clean.js", "settings.js", "content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["clean.js", "inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
